module disparity_estimator #(
	parameter int unsigned IMAGE_DIM    = 128,
	parameter int unsigned IMAGE_DIM_BS = 7
)(
	input  wire                     clk,
	input  wire                     epi_valid_in,
	input  wire [14:0]              epi_column_in [0:8],
	input  wire [IMAGE_DIM_BS-1:0]  epi_column_idx_in,
	input  wire [IMAGE_DIM_BS-1:0]  epi_idx_in,
	input  wire                     epi_orientation_in,
	input  wire                     angular_derivative_valid_in,
	input  wire [14:0]              angular_derivative_column_in [0:6],
	input  wire [IMAGE_DIM_BS-1:0]  angular_derivative_row_idx_in,
	input  wire [IMAGE_DIM_BS-1:0]  angular_derivative_column_idx_in,
	input  wire                     angular_derivative_orientation_in,
	output logic                    disparity_valid_out,
	output logic [14:0]             disparity_pixel_out,
	output logic [IMAGE_DIM_BS-1:0] disparity_row_idx_out,
	output logic [IMAGE_DIM_BS-1:0] disparity_column_idx_out,
	output logic                    orientation_out
);

	assign disparity_valid_out		= 0;
	assign disparity_pixel_out		= 0;
	assign disparity_row_idx_out	= 0;
	assign disparity_column_idx_out = 0;
	assign orientation_out			= 0;

	// -------------------------------------------------------------------------
	// Spatial derivative computations
	// -------------------------------------------------------------------------
	// Inputs are coming in by column
	// So we need to store previous 2 columns before we can compute (n-2, n-1)
	logic [14:0] epi_column_in_nm2 [0:6];
	logic [14:0] epi_column_in_nm1 [0:6];

	// Columns of signed values to store derivative
	logic signed [15:0] spatial_derivatives [0:6];

	logic spatial_dervatives_valid							= 0;
	logic [IMAGE_DIM_BS-1:0] spatial_derivatives_row_idx	= 0;
	logic [IMAGE_DIM_BS-1:0] spatial_derivatives_column_idx	= 0;

	always_ff @(posedge clk) begin : Spatial_Derivative_Computations
		// We only store/use 7 of the 9 views since there are only 7 output rows in the angular derivative
		// Edge 0 and 8 indexed captures (epi_column_in) have no corresponding angular derivative data
		if (epi_valid_in) begin
			// Store previous 2 columns
			epi_column_in_nm1[0] <= epi_column_in[1];
			epi_column_in_nm1[1] <= epi_column_in[2];
			epi_column_in_nm1[2] <= epi_column_in[3];
			epi_column_in_nm1[3] <= epi_column_in[4];
			epi_column_in_nm1[4] <= epi_column_in[5];
			epi_column_in_nm1[5] <= epi_column_in[6];
			epi_column_in_nm1[6] <= epi_column_in[7];

			epi_column_in_nm2[0] <= epi_column_in_nm1[1];
			epi_column_in_nm2[1] <= epi_column_in_nm1[2];
			epi_column_in_nm2[2] <= epi_column_in_nm1[3];
			epi_column_in_nm2[3] <= epi_column_in_nm1[4];
			epi_column_in_nm2[4] <= epi_column_in_nm1[5];
			epi_column_in_nm2[5] <= epi_column_in_nm1[6];
			epi_column_in_nm2[6] <= epi_column_in_nm1[7];
		end

		// Compute spatial derivative
		// We are effectively using a 3x1 kernel, which is [-1/2, 0, 1/2]
		spatial_derivatives[0] <= (epi_column_in[1] - epi_column_in_nm2[0]) >> 1;
		spatial_derivatives[1] <= (epi_column_in[2] - epi_column_in_nm2[1]) >> 1;
		spatial_derivatives[2] <= (epi_column_in[3] - epi_column_in_nm2[2]) >> 1;
		spatial_derivatives[3] <= (epi_column_in[4] - epi_column_in_nm2[3]) >> 1;
		spatial_derivatives[4] <= (epi_column_in[5] - epi_column_in_nm2[4]) >> 1;
		spatial_derivatives[5] <= (epi_column_in[6] - epi_column_in_nm2[5]) >> 1;
		spatial_derivatives[6] <= (epi_column_in[7] - epi_column_in_nm2[6]) >> 1;

		// Spatial derivatives are only valid between columns 1->n-2 (Not edges)
		// When epi_column_idx_in == 0 it is last pixel of previous row
		// When epi_column_idx_in == 1 it is first pixel current previous row
		spatial_dervatives_valid <= (epi_column_idx_in >= 2) && epi_valid_in;

		// Note the row and column index that the derivative corresponds to
		spatial_derivatives_row_idx	   <= epi_idx_in;
		spatial_derivatives_column_idx <= epi_column_idx_in-1;
	end

	// -------------------------------------------------------------------------
	// Store incoming computed angular derivatives
	// -------------------------------------------------------------------------
	logic angular_derivative_valid_in_nm4							= 0;
	logic [14:0] angular_derivative_column_in_nm4 [0:6];
	logic [IMAGE_DIM_BS-1:0] angular_derivative_row_idx_in_nm4		= 0;
	logic [IMAGE_DIM_BS-1:0] angular_derivative_column_idx_in_nm4	= 0;
	logic angular_derivative_orientation_in_nm4						= 0;

	logic angular_derivative_valid_in_nm3							= 0;
	logic [14:0] angular_derivative_column_in_nm3 [0:6];
	logic [IMAGE_DIM_BS-1:0] angular_derivative_row_idx_in_nm3		= 0;
	logic [IMAGE_DIM_BS-1:0] angular_derivative_column_idx_in_nm3	= 0;
	logic angular_derivative_orientation_in_nm3						= 0;

	logic angular_derivative_valid_in_nm2							= 0;
	logic [14:0] angular_derivative_column_in_nm2 [0:6];
	logic [IMAGE_DIM_BS-1:0] angular_derivative_row_idx_in_nm2		= 0;
	logic [IMAGE_DIM_BS-1:0] angular_derivative_column_idx_in_nm2	= 0;
	logic angular_derivative_orientation_in_nm2						= 0;

	logic angular_derivative_valid_in_nm1							= 0;
	logic [14:0] angular_derivative_column_in_nm1 [0:6];
	logic [IMAGE_DIM_BS-1:0] angular_derivative_row_idx_in_nm1		= 0;
	logic [IMAGE_DIM_BS-1:0] angular_derivative_column_idx_in_nm1	= 0;
	logic angular_derivative_orientation_in_nm1						= 0;

	always_ff @(posedge clk) begin : Shift_Angular_Derivative
		angular_derivative_valid_in_nm1 	  <= angular_derivative_valid_in;
		angular_derivative_column_in_nm1[0]   <= angular_derivative_column_in[0];
		angular_derivative_column_in_nm1[1]   <= angular_derivative_column_in[1];
		angular_derivative_column_in_nm1[2]   <= angular_derivative_column_in[2];
		angular_derivative_column_in_nm1[3]   <= angular_derivative_column_in[3];
		angular_derivative_column_in_nm1[4]   <= angular_derivative_column_in[4];
		angular_derivative_column_in_nm1[5]   <= angular_derivative_column_in[5];
		angular_derivative_column_in_nm1[6]   <= angular_derivative_column_in[6];
		angular_derivative_row_idx_in_nm1 	  <= angular_derivative_row_idx_in;
		angular_derivative_column_idx_in_nm1  <= angular_derivative_column_idx_in;
		angular_derivative_orientation_in_nm1 <= angular_derivative_orientation_in;

		angular_derivative_valid_in_nm2 	  <= angular_derivative_valid_in_nm1;
		angular_derivative_column_in_nm2[0]   <= angular_derivative_column_in_nm1[0];
		angular_derivative_column_in_nm2[1]   <= angular_derivative_column_in_nm1[1];
		angular_derivative_column_in_nm2[2]   <= angular_derivative_column_in_nm1[2];
		angular_derivative_column_in_nm2[3]   <= angular_derivative_column_in_nm1[3];
		angular_derivative_column_in_nm2[4]   <= angular_derivative_column_in_nm1[4];
		angular_derivative_column_in_nm2[5]   <= angular_derivative_column_in_nm1[5];
		angular_derivative_column_in_nm2[6]   <= angular_derivative_column_in_nm1[6];
		angular_derivative_row_idx_in_nm2 	  <= angular_derivative_row_idx_in_nm1;
		angular_derivative_column_idx_in_nm2  <= angular_derivative_column_idx_in_nm1;
		angular_derivative_orientation_in_nm2 <= angular_derivative_orientation_in_nm1;

		angular_derivative_valid_in_nm3 	  <= angular_derivative_valid_in_nm2;
		angular_derivative_column_in_nm3[0]   <= angular_derivative_column_in_nm2[0];
		angular_derivative_column_in_nm3[1]   <= angular_derivative_column_in_nm2[1];
		angular_derivative_column_in_nm3[2]   <= angular_derivative_column_in_nm2[2];
		angular_derivative_column_in_nm3[3]   <= angular_derivative_column_in_nm2[3];
		angular_derivative_column_in_nm3[4]   <= angular_derivative_column_in_nm2[4];
		angular_derivative_column_in_nm3[5]   <= angular_derivative_column_in_nm2[5];
		angular_derivative_column_in_nm3[6]   <= angular_derivative_column_in_nm2[6];
		angular_derivative_row_idx_in_nm3 	  <= angular_derivative_row_idx_in_nm2;
		angular_derivative_column_idx_in_nm3  <= angular_derivative_column_idx_in_nm2;
		angular_derivative_orientation_in_nm3 <= angular_derivative_orientation_in_nm2;

		angular_derivative_valid_in_nm4 	  <= angular_derivative_valid_in_nm3;
		angular_derivative_column_in_nm4[0]   <= angular_derivative_column_in_nm3[0];
		angular_derivative_column_in_nm4[1]   <= angular_derivative_column_in_nm3[1];
		angular_derivative_column_in_nm4[2]   <= angular_derivative_column_in_nm3[2];
		angular_derivative_column_in_nm4[3]   <= angular_derivative_column_in_nm3[3];
		angular_derivative_column_in_nm4[4]   <= angular_derivative_column_in_nm3[4];
		angular_derivative_column_in_nm4[5]   <= angular_derivative_column_in_nm3[5];
		angular_derivative_column_in_nm4[6]   <= angular_derivative_column_in_nm3[6];
		angular_derivative_row_idx_in_nm4 	  <= angular_derivative_row_idx_in_nm3;
		angular_derivative_column_idx_in_nm4  <= angular_derivative_column_idx_in_nm3;
		angular_derivative_orientation_in_nm4 <= angular_derivative_orientation_in_nm3;
	end

	assign disparity_valid_out = 0;
	assign disparity_pixel_out = 0;
	assign disparity_row_idx_out = 0;
	assign disparity_column_idx_out = 0;
	assign orientation_out = 0;
endmodule