module epi_compiler #(
	parameter int unsigned IMAGE_DIM    = 128,
	parameter int unsigned IMAGE_DIM_BS = 7
)(
	input  wire                     clk,
	input  wire                     epi_valid_in,
	input  wire [14:0]              epi_column_in [0:8],
	input  wire [IMAGE_DIM_BS-1:0]  epi_idx_column_in,
	input  wire [IMAGE_DIM_BS-1:0]  epi_idx_in,
	input  wire                     orientation_in,
	output logic                    confidence_vaild_out,
	output logic [14:0]             confidence_pixel_out,
	output logic signed [15:0]      derivative_epi_column_out [0:8],
	output logic [IMAGE_DIM_BS-1:0] derivative_epi_column_idx_out,
	output logic [IMAGE_DIM_BS-1:0] derivative_epi_idx_out,
	output logic                    orientation_out
);

	// -------------------------------------------------------------------------
	// Variables to remember the inputs from the last valid epi
	// -------------------------------------------------------------------------
	logic last_epi_in_was_valid						= 0;
	logic [IMAGE_DIM_BS-1:0] last_epi_idx_column_in = 0;
	logic [IMAGE_DIM_BS-1:0] last_epi_idx_in        = 0;
	logic last_orientation_in						= 0;

	always_ff @(posedge clk) begin : Remember_Last_Valid_Inputs
		if (epi_valid_in) begin
			last_epi_in_was_valid  <= 1;
			last_epi_idx_column_in <= epi_idx_column_in;
			last_epi_idx_in 	   <= epi_idx_in;
			last_orientation_in    <= orientation_in;
		end

		else begin
			last_epi_in_was_valid <= 0;
		end
	end

	// -------------------------------------------------------------------------
	// Set clock-based outputs
	// -------------------------------------------------------------------------
	always_ff @(posedge clk) begin : Set_Outputs
		confidence_vaild_out <= last_epi_in_was_valid;
		orientation_out <= last_orientation_in;
	end

	// -------------------------------------------------------------------------
	// Derivative computations
	// -------------------------------------------------------------------------
	localparam int unsigned DERIVATIVE_DATA_WIDTH = 16

	// + 1 bit for signed
	logic signed [DERIVATIVE_DATA_WIDTH:0] computed_derivative_epi_column_out_1 = 0;
	logic signed [DERIVATIVE_DATA_WIDTH:0] computed_derivative_epi_column_out_2 = 0;
	logic signed [DERIVATIVE_DATA_WIDTH:0] computed_derivative_epi_column_out_3 = 0;
	logic signed [DERIVATIVE_DATA_WIDTH:0] computed_derivative_epi_column_out_4 = 0;
	logic signed [DERIVATIVE_DATA_WIDTH:0] computed_derivative_epi_column_out_5 = 0;
	logic signed [DERIVATIVE_DATA_WIDTH:0] computed_derivative_epi_column_out_6 = 0;
	logic signed [DERIVATIVE_DATA_WIDTH:0] computed_derivative_epi_column_out_7 = 0;

	assign derivative_epi_column_out[0] <= 0;
	assign derivative_epi_column_out[8] <= 0;

	always_ff @(posedge clk) begin : dLdU_dLdV_Computation
		if (epi_valid_in) begin
		end
	end

	always_ff @(posedge clk) begin : : dLdU_dLdV
		computed_derivative_epi_column_out_1 = (epi_column_in[2] - epi_column_in[0]) >> 1;
		computed_derivative_epi_column_out_2 = (epi_column_in[3] - epi_column_in[1]) >> 1;
		computed_derivative_epi_column_out_3 = (epi_column_in[4] - epi_column_in[2]) >> 1;
		computed_derivative_epi_column_out_4 = (epi_column_in[5] - epi_column_in[3]) >> 1;
		computed_derivative_epi_column_out_5 = (epi_column_in[6] - epi_column_in[4]) >> 1;
		computed_derivative_epi_column_out_6 = (epi_column_in[7] - epi_column_in[5]) >> 1;
		computed_derivative_epi_column_out_7 = (epi_column_in[8] - epi_column_in[6]) >> 1;
		
		derivative_epi_column_out[1] <= computed_derivative_epi_column_out_1;
		derivative_epi_column_out[2] <= computed_derivative_epi_column_out_2;
		derivative_epi_column_out[3] <= computed_derivative_epi_column_out_3;
		derivative_epi_column_out[4] <= computed_derivative_epi_column_out_4;
		derivative_epi_column_out[5] <= computed_derivative_epi_column_out_5;
		derivative_epi_column_out[6] <= computed_derivative_epi_column_out_6;
		derivative_epi_column_out[7] <= computed_derivative_epi_column_out_7;

		derivative_epi_column_idx_out <= last_epi_idx_column_in;
		derivative_epi_idx_out 		  <= last_epi_idx_in;
	end

	// -------------------------------------------------------------------------
	// Confidence computations
	// -------------------------------------------------------------------------
	// No longer + 1 bit as output is not signed
	logic unsigned [DERIVATIVE_DATA_WIDTH-1:0] absolute_derivative_epi_column_out_1 = 0;
	logic unsigned [DERIVATIVE_DATA_WIDTH-1:0] absolute_derivative_epi_column_out_2 = 0;
	logic unsigned [DERIVATIVE_DATA_WIDTH-1:0] absolute_derivative_epi_column_out_3 = 0;
	logic unsigned [DERIVATIVE_DATA_WIDTH-1:0] absolute_derivative_epi_column_out_4 = 0;
	logic unsigned [DERIVATIVE_DATA_WIDTH-1:0] absolute_derivative_epi_column_out_5 = 0;
	logic unsigned [DERIVATIVE_DATA_WIDTH-1:0] absolute_derivative_epi_column_out_6 = 0;
	logic unsigned [DERIVATIVE_DATA_WIDTH-1:0] absolute_derivative_epi_column_out_7 = 0;

	always_ff @(posedge clk) begin : Absolute_Derivative
		absolute_derivative_epi_column_out_1 <= computed_derivative_epi_column_out_1[DERIVATIVE_DATA_WIDTH-1] ? -computed_derivative_epi_column_out_1 : computed_derivative_epi_column_out_1;
		absolute_derivative_epi_column_out_2 <= computed_derivative_epi_column_out_2[DERIVATIVE_DATA_WIDTH-1] ? -computed_derivative_epi_column_out_2 : computed_derivative_epi_column_out_2;
		absolute_derivative_epi_column_out_3 <= computed_derivative_epi_column_out_3[DERIVATIVE_DATA_WIDTH-1] ? -computed_derivative_epi_column_out_3 : computed_derivative_epi_column_out_3;
		absolute_derivative_epi_column_out_4 <= computed_derivative_epi_column_out_4[DERIVATIVE_DATA_WIDTH-1] ? -computed_derivative_epi_column_out_4 : computed_derivative_epi_column_out_4;
		absolute_derivative_epi_column_out_5 <= computed_derivative_epi_column_out_5[DERIVATIVE_DATA_WIDTH-1] ? -computed_derivative_epi_column_out_5 : computed_derivative_epi_column_out_5;
		absolute_derivative_epi_column_out_6 <= computed_derivative_epi_column_out_6[DERIVATIVE_DATA_WIDTH-1] ? -computed_derivative_epi_column_out_6 : computed_derivative_epi_column_out_6;
		absolute_derivative_epi_column_out_7 <= computed_derivative_epi_column_out_7[DERIVATIVE_DATA_WIDTH-1] ? -computed_derivative_epi_column_out_7 : computed_derivative_epi_column_out_7;

		// Confidence is the average of the absolute derivatives
		// We can just bit shift to decrease latency,
		// It is not underestimating confidence by 1/8, but is relatively accurate across a frame
		confidence_pixel_out <= (absolute_derivative_epi_column_out_1 + 
								 absolute_derivative_epi_column_out_2 + 
								 absolute_derivative_epi_column_out_3 + 
								 absolute_derivative_epi_column_out_4 + 
								 absolute_derivative_epi_column_out_5 + 
								 absolute_derivative_epi_column_out_6 + 
								 absolute_derivative_epi_column_out_7) >> 3 // Divide by 8
	end
endmodule